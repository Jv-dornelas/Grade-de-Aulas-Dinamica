' DER atualizado de Grade de Aulas Dinâmica
' Cada bloco pode ser copiado e renderizado separadamente no PlantUML.

@startuml DER_01_Cadastros
title Grade de Aulas Dinâmica - 1/6 - Usuários e cadastros
left to right direction
hide circle
skinparam linetype polyline

entity "auth_user" as Usuario {
  * id : INTEGER <<PK>>
  --
  * username : VARCHAR(150) <<UK>>
  * password : VARCHAR(128)
  * first_name : VARCHAR(150)
  * last_name : VARCHAR(150)
  * email : VARCHAR(254)
  * is_active : BOOLEAN
  * is_staff : BOOLEAN
  * is_superuser : BOOLEAN
  last_login : DATETIME
  * date_joined : DATETIME
}

entity "grade_unidade" as Unidade {
  * id : INTEGER <<PK>>
  --
  * nome : VARCHAR(50)
  * responsavel : VARCHAR(100)
  endereco : VARCHAR(200)
  cidade : VARCHAR(100)
  cep : VARCHAR(15)
}

entity "grade_sala" as Sala {
  * id : INTEGER <<PK>>
  --
  * unidade_id : INTEGER <<FK>>
  * nome : VARCHAR(60)
  * ativa : BOOLEAN
  ==
  UNIQUE(unidade_id, nome)
}

entity "grade_disciplina" as Disciplina {
  * id : INTEGER <<PK>>
  --
  * nome : VARCHAR(100)
  * area : VARCHAR(20)
}

entity "grade_professor" as Professor {
  * id : INTEGER <<PK>>
  --
  usuario_id : INTEGER <<FK, UK>>
  unidade_oficial_id : INTEGER <<FK>>
  parente_vinculado_id : INTEGER <<FK>>
  * nome : VARCHAR(100)
  telefone : VARCHAR(20)
  email : VARCHAR(254)
  * meio_de_transporte : VARCHAR(20)
  * limite_aulas : INTEGER = 5
  observacao : TEXT
}

entity "grade_professor_disciplinas" as ProfessorDisciplina {
  * id : INTEGER <<PK>>
  --
  * professor_id : INTEGER <<FK>>
  * disciplina_id : INTEGER <<FK>>
  ==
  UNIQUE(professor_id, disciplina_id)
}

entity "grade_professor_unidades_permitidas" as ProfessorUnidade {
  * id : INTEGER <<PK>>
  --
  * professor_id : INTEGER <<FK>>
  * unidade_id : INTEGER <<FK>>
  ==
  UNIQUE(professor_id, unidade_id)
}

Usuario "0..1" -- "0..1" Professor : conta vinculada
Professor "0..*" -- "0..1" Professor : parente_vinculado
Professor "0..*" -- "0..1" Unidade : unidade oficial
Professor "1" -- "0..*" ProfessorDisciplina
ProfessorDisciplina "0..*" -- "1" Disciplina
Professor "1" -- "0..*" ProfessorUnidade
ProfessorUnidade "0..*" -- "1" Unidade
Unidade "1" -- "0..*" Sala
@enduml

@startuml DER_02_Cursos
title Grade de Aulas Dinâmica - 2/6 - Cursos e matriz curricular
left to right direction
hide circle
skinparam linetype polyline

entity "grade_curso" as Curso {
  * id : INTEGER <<PK>>
  --
  * nome : VARCHAR(100) <<UK>>
  observacoes : TEXT
}

entity "grade_matrizcurricular" as MatrizCurricular {
  * id : INTEGER <<PK>>
  --
  * curso_id : INTEGER <<FK>>
  * disciplina_id : INTEGER <<FK>>
  * quantidade_semana : INTEGER
  ==
  UNIQUE(curso_id, disciplina_id)
}

entity "grade_disciplina" as Disciplina {
  * id : INTEGER <<PK>>
  --
  * nome : VARCHAR(100)
  * area : VARCHAR(20)
}

entity "grade_turma" as Turma {
  * id : INTEGER <<PK>>
  --
  * unidade_id : INTEGER <<FK>>
  curso_id : INTEGER <<FK>>
  * nome : VARCHAR(80)
  * materias_fixas : BOOLEAN
  turno_principal : VARCHAR(5)
  dia_contraturno : INTEGER
  * dias_semana : JSON
  ==
  UNIQUE(unidade_id, nome)
}

entity "grade_unidade" as Unidade {
  * id : INTEGER <<PK>>
  --
  * nome : VARCHAR(50)
  * responsavel : VARCHAR(100)
}

Curso "1" -- "0..*" MatrizCurricular
MatrizCurricular "0..*" -- "1" Disciplina
Curso "1" -- "0..*" Turma : oferta vinculada
Turma "0..*" -- "1" Unidade
@enduml

@startuml DER_03_Planejamento
title Grade de Aulas Dinâmica - 3/6 - Turmas, horários e demandas
left to right direction
hide circle
skinparam linetype polyline

entity "grade_horarioaula" as Horario {
  * id : INTEGER <<PK>>
  --
  * nome : VARCHAR(20)
  * hora_inicio : TIME
  * hora_fim : TIME
}

entity "grade_turma" as Turma {
  * id : INTEGER <<PK>>
  --
  * unidade_id : INTEGER <<FK>>
  curso_id : INTEGER <<FK>>
  * nome : VARCHAR(80)
  * dias_semana : JSON
}

entity "grade_turma_horarios" as TurmaHorario {
  * id : INTEGER <<PK>>
  --
  * turma_id : INTEGER <<FK>>
  * horarioaula_id : INTEGER <<FK>>
  ==
  UNIQUE(turma_id, horarioaula_id)
}

entity "grade_demandaaula" as Demanda {
  * id : INTEGER <<PK>>
  --
  * turma_id : INTEGER <<FK>>
  * disciplina_id : INTEGER <<FK>>
  professor_id : INTEGER <<FK>>
  * quantidade_semana : INTEGER
  * ativa : BOOLEAN
  * origem_curso : BOOLEAN
  ==
  UNIQUE(turma_id, disciplina_id)
}

entity "grade_horariocurricular" as HorarioCurricular {
  * id : INTEGER <<PK>>
  --
  * turma_id : INTEGER <<FK>>
  * demanda_id : INTEGER <<FK>>
  * dia_semana : INTEGER
  * horario_id : INTEGER <<FK>>
  ==
  UNIQUE(turma_id, dia_semana, horario_id)
}

entity "grade_disciplina" as Disciplina {
  * id : INTEGER <<PK>>
}

entity "grade_professor" as Professor {
  * id : INTEGER <<PK>>
}

Turma "1" -- "0..*" TurmaHorario
TurmaHorario "0..*" -- "1" Horario
Turma "1" -- "0..*" Demanda : possui demanda
Demanda "0..*" -- "1" Disciplina
Demanda "0..*" -- "0..1" Professor : professor fixado
Turma "1" -- "0..*" HorarioCurricular
Demanda "1" -- "0..*" HorarioCurricular
HorarioCurricular "0..*" -- "1" Horario
@enduml

@startuml DER_04_Disponibilidade
title Grade de Aulas Dinâmica - 4/6 - Disponibilidade dos professores
left to right direction
hide circle
skinparam linetype polyline

entity "grade_professor" as Professor {
  * id : INTEGER <<PK>>
  * nome : VARCHAR(100)
}

entity "grade_disponibilidade" as Disponibilidade {
  * id : INTEGER <<PK>>
  --
  * professor_id : INTEGER <<FK>>
  * data : DATE
  * disponivel_manha : BOOLEAN
  * disponivel_tarde : BOOLEAN
}

entity "grade_disponibilidadehorario" as DisponibilidadeHorario {
  * id : INTEGER <<PK>>
  --
  * professor_id : INTEGER <<FK>>
  * horario_id : INTEGER <<FK>>
  * data : DATE
  * disponivel : BOOLEAN
  ==
  UNIQUE(professor_id, data, horario_id)
}

entity "grade_horarioaula" as Horario {
  * id : INTEGER <<PK>>
  --
  * hora_inicio : TIME
  * hora_fim : TIME
}

Professor "1" -- "0..*" Disponibilidade
Professor "1" -- "0..*" DisponibilidadeHorario
DisponibilidadeHorario "0..*" -- "1" Horario
@enduml

@startuml DER_05_Alocacoes
title Grade de Aulas Dinâmica - 5/6 - Alocações e aprovação
left to right direction
hide circle
skinparam linetype polyline

entity "grade_alocacaograde" as Alocacao {
  * id : INTEGER <<PK>>
  --
  * data : DATE
  * horario_id : INTEGER <<FK>>
  * unidade_id : INTEGER <<FK>>
  sala_id : INTEGER <<FK>>
  professor_id : INTEGER <<FK>>
  motivo_pendencia : VARCHAR(240)
  turma_id : INTEGER <<FK>>
  disciplina_id : INTEGER <<FK>>
  demanda_id : INTEGER <<FK>>
  eh_excecao_limite_aulas : BOOLEAN
  motivo_excecao_limite : VARCHAR(200)
  eh_excecao_horario : BOOLEAN
  motivo_excecao_horario : VARCHAR(200)
  eh_excecao_deslocamento : BOOLEAN
  motivo_excecao_deslocamento : VARCHAR(200)
  eh_excecao_area_acumulo : BOOLEAN
  motivo_excecao_area_acumulo : VARCHAR(200)
  autorizado_por_id : INTEGER <<FK>>
  criado_em : DATETIME
  atualizado_em : DATETIME
}

entity "grade_aprovacaograde" as Aprovacao {
  * id : INTEGER <<PK>>
  --
  * semana : DATE
  * assinatura : VARCHAR(64)
  aprovado_por_id : INTEGER <<FK>>
  * aprovado_em : DATETIME
  * total_aulas : INTEGER
  * pendentes : INTEGER
  * parcial : BOOLEAN
  ==
  UNIQUE(semana, assinatura)
}

entity "grade_aviso_grade_email" as AvisoEmail {
  * id : INTEGER <<PK>>
  --
  * aprovacao_id : INTEGER <<FK>>
  * professor_id : INTEGER <<FK>>
  destinatario : VARCHAR(254)
  * assinatura_grade : VARCHAR(64)
  * assunto : VARCHAR(200)
  * corpo : TEXT
  * estado : VARCHAR(20)
  * tentativas : INTEGER
  * atualizado_em : DATETIME
  ==
  UNIQUE(aprovacao_id, professor_id)
}

entity "grade_professor" as Professor { * id : INTEGER <<PK>> }
entity "grade_unidade" as Unidade { * id : INTEGER <<PK>> }
entity "grade_sala" as Sala { * id : INTEGER <<PK>> }
entity "grade_horarioaula" as Horario { * id : INTEGER <<PK>> }
entity "grade_turma" as Turma { * id : INTEGER <<PK>> }
entity "grade_disciplina" as Disciplina { * id : INTEGER <<PK>> }
entity "grade_demandaaula" as Demanda { * id : INTEGER <<PK>> }
entity "auth_user" as Usuario { * id : INTEGER <<PK>> }

Professor "1" -- "0..*" Alocacao : leciona
Unidade "1" -- "0..*" Alocacao : recebe
Sala "0..1" -- "0..*" Alocacao : reserva
Horario "1" -- "0..*" Alocacao : possui
Alocacao "0..*" -- "0..1" Turma
Alocacao "0..*" -- "0..1" Disciplina
Alocacao "0..*" -- "0..1" Demanda
Alocacao "0..*" -- "0..1" Usuario : autorizado por

Usuario "1" -- "0..*" Aprovacao : aprova
Aprovacao "1" -- "0..*" AvisoEmail
Professor "1" -- "0..*" AvisoEmail
@enduml

@startuml DER_06_Automacao
title Grade de Aulas Dinâmica - 6/6 - Trajetos e configuração
left to right direction
hide circle
skinparam linetype polyline

entity "grade_unidade" as Unidade {
  * id : INTEGER <<PK>>
  * nome : VARCHAR(50)
}

entity "grade_matrizdistancia" as MatrizDistancia {
  * id : INTEGER <<PK>>
  --
  * origem_id : INTEGER <<FK>>
  * destino_id : INTEGER <<FK>>
  * tempo_minutos : INTEGER
  distancia_km : DECIMAL
  fonte : VARCHAR(30)
  consultado_em : DATETIME
  enderecos_hash : VARCHAR(64)
}

entity "grade_cacheconsultamapas" as CacheMapas {
  * chave : VARCHAR(64) <<PK>>
  --
  * dados : JSON
  * criado_em : DATETIME
}

entity "grade_configuracaoautomacao" as Configuracao {
  * id : INTEGER <<PK>> = 1
  --
  * proximidade_parentesco_minutos : INTEGER = 15
}

Unidade "1" -- "0..*" MatrizDistancia : origem
Unidade "1" -- "0..*" MatrizDistancia : destino
@enduml
