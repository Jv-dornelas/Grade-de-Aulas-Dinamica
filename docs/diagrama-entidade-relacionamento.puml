' DER completo distribuído em cinco vistas do mesmo modelo.
' Cada bloco @startuml pode ser copiado e renderizado separadamente.
' Entidades repetidas são referências, não novas tabelas.
' Tipos lógicos e cardinalidades conforme grade/models.py.

@startuml DER_01_Professores
title
Grade de Aulas Dinâmica
1/5 - Professores, acesso e habilitações
end title
left to right direction
hide circle
skinparam shadowing false
skinparam linetype polyline
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 13
skinparam nodesep 45
skinparam ranksep 65
skinparam padding 12
skinparam roundcorner 8
skinparam classBorderColor #365B80
skinparam ArrowColor #365B80
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #CCD6E0

entity "Usuário" as Usuario #EEF5FC {
  * id : INTEGER <<PK>>
  --
  * username : VARCHAR(150) <<UK>>
  * password : VARCHAR(128)
  * first_name : VARCHAR(150)
  * last_name : VARCHAR(150)
  * email : VARCHAR(254)
  * is_active : BOOLEAN
  * is_staff : BOOLEAN
  * is_superuser : BOOLEAN
  last_login : DATETIME
  * date_joined : DATETIME
}
entity "Professor" as Professor #EEF5FC {
  * id : INTEGER <<PK>>
  --
  usuario_id : INTEGER <<FK, UK>>
  unidade_oficial_id : INTEGER <<FK>>
  parente_vinculado_id : INTEGER <<FK>>
  * nome : VARCHAR(100)
  telefone : VARCHAR(20)
  email : VARCHAR(254)
  * meio_de_transporte : VARCHAR(20) = PARTICULAR
  * limite_aulas : INTEGER >= 0 = 5
  observacao : TEXT
}
entity "Unidade" as Unidade #F1F3F5 {
  * id : INTEGER <<PK>>
}
entity "Disciplina" as Disciplina #F1F3F5 {
  * id : INTEGER <<PK>>
}
entity "ProfessorDisciplina" as ProfessorDisciplina #E9F5EF {
  * id : INTEGER <<PK>>
  --
  * professor_id : INTEGER <<FK>>
  * disciplina_id : INTEGER <<FK>>
}
entity "ProfessorUnidadePermitida" as ProfessorUnidade #E9F5EF {
  * id : INTEGER <<PK>>
  --
  * professor_id : INTEGER <<FK>>
  * unidade_id : INTEGER <<FK>>
}
entity "Professor (papel: parente)" as Parente #F1F3F5 {
  * id : INTEGER <<PK>>
}

Usuario "0..1" -- "0..1" Professor : conta de acesso
Professor "0..*" -- "0..1" Parente : parente_vinculado
Professor "1" -- "0..*" ProfessorDisciplina
ProfessorDisciplina "0..*" -- "1" Disciplina
Professor "1" -- "0..*" ProfessorUnidade
ProfessorUnidade "0..*" -- "1" Unidade
Professor "0..*" -- "0..1" Unidade : unidade oficial

legend bottom left
  Professor (papel: parente) é a mesma entidade Professor, repetida para facilitar a leitura.
  Cada professor aponta para até um parente; vários professores podem apontar para o mesmo parente.
  Tabelas verdes resolvem N:N e têm UNIQUE no par de FKs.
  Cardinalidades: 1 = exatamente um; 0..1 = opcional; 0..* = zero ou muitos.
  PK = chave primária; FK = chave estrangeira; UK = chave única; * = NOT NULL.
  Blocos cinza mostram apenas a chave de entidades detalhadas em outra vista.
endlegend
@enduml

@startuml DER_02_Planejamento
title
Grade de Aulas Dinâmica
2/5 - Turmas, horários permitidos e demandas
end title
left to right direction
hide circle
skinparam shadowing false
skinparam linetype polyline
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 13
skinparam nodesep 45
skinparam ranksep 65
skinparam padding 12
skinparam roundcorner 8
skinparam classBorderColor #365B80
skinparam ArrowColor #365B80
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #CCD6E0

entity "Unidade" as Unidade #EEF5FC {
  * id : INTEGER <<PK>>
  --
  * nome : VARCHAR(50)
  * responsavel : VARCHAR(100)
  endereco : VARCHAR(200)
  cidade : VARCHAR(100)
  cep : VARCHAR(15)
}
entity "Turma" as Turma #EEF5FC {
  * id : INTEGER <<PK>>
  --
  * unidade_id : INTEGER <<FK>>
  * nome : VARCHAR(80)
  * dias_semana : JSON = [0,1,2,3,4]
}
entity "HorarioAula" as HorarioAula #EEF5FC {
  * id : INTEGER <<PK>>
  --
  * nome : VARCHAR(20)
  * hora_inicio : TIME
  * hora_fim : TIME
}
entity "TurmaHorario" as TurmaHorario #E9F5EF {
  * id : INTEGER <<PK>>
  --
  * turma_id : INTEGER <<FK>>
  * horarioaula_id : INTEGER <<FK>>
}
entity "DemandaAula" as DemandaAula #EEF5FC {
  * id : INTEGER <<PK>>
  --
  * turma_id : INTEGER <<FK>>
  * disciplina_id : INTEGER <<FK>>
  professor_id : INTEGER <<FK>>
  * quantidade_semana : INTEGER = 1
  * ativa : BOOLEAN = true
}
entity "Disciplina" as Disciplina #EEF5FC {
  * id : INTEGER <<PK>>
  --
  * nome : VARCHAR(100)
  * area : VARCHAR(20)
}
entity "Professor" as Professor #F1F3F5 {
  * id : INTEGER <<PK>>
}

Unidade "1" -- "0..*" Turma : possui
Turma "1" -- "0..*" TurmaHorario
TurmaHorario "0..*" -- "1" HorarioAula
Turma "1" -- "0..*" DemandaAula : necessita
DemandaAula "0..*" -- "1" Disciplina : disciplina solicitada
DemandaAula "0..*" -- "0..1" Professor : professor fixado

legend bottom left
  UNIQUE: Turma(unidade_id, nome); TurmaHorario(turma_id, horarioaula_id).
  UNIQUE: DemandaAula(turma_id, disciplina_id). Professor fixado é opcional.
  dias_semana é JSON: 0 = segunda; 6 = domingo. A demanda informa aulas por semana.
  Cardinalidades: 1 = exatamente um; 0..1 = opcional; 0..* = zero ou muitos.
  PK = chave primária; FK = chave estrangeira; UK = chave única; * = NOT NULL.
  Blocos cinza mostram apenas a chave de entidades detalhadas em outra vista.
endlegend
@enduml

@startuml DER_03_Disponibilidades
title
Grade de Aulas Dinâmica
3/5 - Disponibilidade por turno e por horário
end title
left to right direction
hide circle
skinparam shadowing false
skinparam linetype polyline
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 13
skinparam nodesep 45
skinparam ranksep 65
skinparam padding 12
skinparam roundcorner 8
skinparam classBorderColor #365B80
skinparam ArrowColor #365B80
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #CCD6E0

entity "Professor" as Professor #F1F3F5 {
  * id : INTEGER <<PK>>
}
entity "Disponibilidade" as Disponibilidade #EEF5FC {
  * id : INTEGER <<PK>>
  --
  * professor_id : INTEGER <<FK>>
  * data : DATE
  * disponivel_manha : BOOLEAN = false
  * disponivel_tarde : BOOLEAN = false
}
entity "DisponibilidadeHorario" as DisponibilidadeHorario #EEF5FC {
  * id : INTEGER <<PK>>
  --
  * professor_id : INTEGER <<FK>>
  * horario_id : INTEGER <<FK>>
  * data : DATE
  * disponivel : BOOLEAN = true
}
entity "HorarioAula" as HorarioAula #F1F3F5 {
  * id : INTEGER <<PK>>
}

Professor "1" -- "0..*" Disponibilidade : por data e turno
Professor "1" -- "0..*" DisponibilidadeHorario : por data e horário
DisponibilidadeHorario "0..*" -- "1" HorarioAula

legend bottom left
  UNIQUE: DisponibilidadeHorario(professor_id, data, horario_id).
  A decisão por horário tem prioridade sobre a disponibilidade por turno.
  Disponibilidade não possui UNIQUE(professor_id, data) no modelo atual.
  Cardinalidades: 1 = exatamente um; 0..1 = opcional; 0..* = zero ou muitos.
  PK = chave primária; FK = chave estrangeira; UK = chave única; * = NOT NULL.
  Blocos cinza mostram apenas a chave de entidades detalhadas em outra vista.
endlegend
@enduml

@startuml DER_04_Alocacoes
title
Grade de Aulas Dinâmica
4/5 - Aulas agendadas, exceções e auditoria
end title
left to right direction
hide circle
skinparam shadowing false
skinparam linetype polyline
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 13
skinparam nodesep 45
skinparam ranksep 65
skinparam padding 12
skinparam roundcorner 8
skinparam classBorderColor #365B80
skinparam ArrowColor #365B80
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #CCD6E0

entity "Professor" as Professor #F1F3F5 {
  * id : INTEGER <<PK>>
}
entity "Unidade" as Unidade #F1F3F5 {
  * id : INTEGER <<PK>>
}
entity "HorarioAula" as HorarioAula #F1F3F5 {
  * id : INTEGER <<PK>>
}
entity "AlocacaoGrade" as AlocacaoGrade #FFF4DE {
  * id : INTEGER <<PK>>
  --
  * horario_id : INTEGER <<FK>>
  * unidade_id : INTEGER <<FK>>
  * professor_id : INTEGER <<FK>>
  turma_id : INTEGER <<FK>>
  disciplina_id : INTEGER <<FK>>
  demanda_id : INTEGER <<FK>>
  autorizado_por_id : INTEGER <<FK>>
  * data : DATE
  * eh_excecao_limite_aulas : BOOLEAN = false
  motivo_excecao_limite : VARCHAR(200)
  * eh_excecao_horario : BOOLEAN = false
  motivo_excecao_horario : VARCHAR(200)
  * eh_excecao_deslocamento : BOOLEAN = false
  motivo_excecao_deslocamento : VARCHAR(200)
  * eh_excecao_area_acumulo : BOOLEAN = false
  motivo_excecao_area_acumulo : VARCHAR(200)
  criado_em : DATETIME
  atualizado_em : DATETIME
}
entity "Turma" as Turma #F1F3F5 {
  * id : INTEGER <<PK>>
}
entity "Disciplina" as Disciplina #F1F3F5 {
  * id : INTEGER <<PK>>
}
entity "DemandaAula" as DemandaAula #F1F3F5 {
  * id : INTEGER <<PK>>
}
entity "Usuário" as Usuario #F1F3F5 {
  * id : INTEGER <<PK>>
}

Professor "1" -- "0..*" AlocacaoGrade : professor da aula
Unidade "1" -- "0..*" AlocacaoGrade : local da aula
HorarioAula "1" -- "0..*" AlocacaoGrade : horário da aula
AlocacaoGrade "0..*" -- "0..1" Turma : turma
AlocacaoGrade "0..*" -- "0..1" Disciplina : disciplina
AlocacaoGrade "0..*" -- "0..1" DemandaAula : demanda atendida
AlocacaoGrade "0..*" -- "0..1" Usuario : autorizado_por

legend bottom left
  Cada alocação exige exatamente um professor, uma unidade e um horário.
  Turma, disciplina, demanda e usuário autorizador aceitam NULL no modelo atual.
  Essas FKs existem diretamente na alocação, mesmo quando a demanda também identifica a turma e a disciplina.
  Cardinalidades: 1 = exatamente um; 0..1 = opcional; 0..* = zero ou muitos.
  PK = chave primária; FK = chave estrangeira; UK = chave única; * = NOT NULL.
  Blocos cinza mostram apenas a chave de entidades detalhadas em outra vista.
endlegend
@enduml

@startuml DER_05_Deslocamentos
title
Grade de Aulas Dinâmica
5/5 - Tempo de deslocamento entre unidades
end title
left to right direction
hide circle
skinparam shadowing false
skinparam linetype polyline
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 13
skinparam nodesep 45
skinparam ranksep 65
skinparam padding 12
skinparam roundcorner 8
skinparam classBorderColor #365B80
skinparam ArrowColor #365B80
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #CCD6E0

entity "Unidade (papel: origem)" as Origem #F1F3F5 {
  * id : INTEGER <<PK>>
}
entity "MatrizDistancia" as MatrizDistancia #EEF5FC {
  * id : INTEGER <<PK>>
  --
  * origem_id : INTEGER <<FK>>
  * destino_id : INTEGER <<FK>>
  * tempo_minutos : INTEGER >= 0
}
entity "Unidade (papel: destino)" as Destino #F1F3F5 {
  * id : INTEGER <<PK>>
}

Origem "1" -- "0..*" MatrizDistancia : origem_id
MatrizDistancia "0..*" -- "1" Destino : destino_id

legend bottom left
  Origem e destino são papéis da mesma tabela Unidade, não são duas tabelas distintas.
  Cada registro exige uma origem e um destino; cada unidade pode aparecer em vários registros.
  O tempo é direcional. Não há UNIQUE(origem_id, destino_id) no modelo atual.
  Cardinalidades: 1 = exatamente um; 0..1 = opcional; 0..* = zero ou muitos.
  PK = chave primária; FK = chave estrangeira; UK = chave única; * = NOT NULL.
  Blocos cinza mostram apenas a chave de entidades detalhadas em outra vista.
endlegend
@enduml
