# Ambiente Virtual
venv/
.venv/
env/

# Variáveis de ambiente (segredos, não versionar)
.env

# Banco de dados local (para não vazar dados reais no GitHub)
*.sqlite3
*.sqlite3-*

# Arquivos do Python / Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Arquivos do VS Code e IDEs
.vscode/
.idea/

# Arquivos estáticos coletados
staticfiles/

# Arquivos compactados
*.zip
android-app/.gradle/
android-app/**/build/
android-app/local.properties
*.apk
*.aab
*.jks
*.keystore

# Artefatos e cópias locais, separados do código-fonte
backups/*
!backups/.gitkeep
output/
tmp/
dist/
