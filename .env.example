SECRET_KEY=troque-por-uma-chave-secreta-gerada-com-get_random_secret_key

# Desenvolvimento local. Uma hospedagem exige configuração e revisão próprias.
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Padrão sem estas variáveis: simulação em tmp/emails, sem entrega real.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=seu-remetente@example.com
# EMAIL_HOST_PASSWORD=configure-localmente-sem-versionar
# DEFAULT_FROM_EMAIL=seu-remetente@example.com
# GRADE_URL_PUBLICA=http://localhost:8000

# Opcional: nome de uma cópia SQLite para testes, criada antes de iniciar o serviço.
# SQLITE_NAME=db.automacao.sqlite3

# Consulta de trajetos pelos endereços, sob demanda. Padrão: habilitada só na cópia local.
# GRADE_MAPAS_HABILITADO=1
# GRADE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# GRADE_ROTAS_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
# Preferência de proximidade entre professores com vínculo familiar/conjugal (administração).
# GRADE_PROXIMIDADE_PARENTESCO_MINUTOS=15
